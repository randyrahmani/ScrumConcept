<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Page not found · ScrumConcept</title>
  <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
</head>
<body class="d-grid min-vh-100" style="place-items:center">
  <%# The catch-all Express route supplies the unmatched request path. %>
  <main class="text-center p-4">
    <div class="display-4 fw-bold text-primary mb-3">SC</div>
    <div class="small fw-bold text-uppercase text-secondary mb-2">Error 404</div>
    <h1 class="h3 fw-bold">That page is not on the board.</h1>
    <p class="text-secondary mb-4">We could not find <code><%= path %></code>.</p>
    <a class="btn btn-primary" href="/">Return to sprint board</a>
  </main>
</body>
</html>
